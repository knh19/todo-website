// --- Todo App JS (yeah, still kinda messy but works fine for now) ---

// grabbing all the elements (maybe later refactor into a single querySelector thing?)
const newTodoInput = document.getElementById('newTodo');
const addBtn = document.getElementById('addBtn');
const todoList = document.getElementById('todoList');
const remaining = document.getElementById('remaining');
const info = document.getElementById('info');
const filters = document.querySelectorAll('.filter-btn');
const clearCompletedBtn = document.getElementById('clearCompleted');

// Load from localStorage – I should probably handle parse errors but meh
let todos = JSON.parse(localStorage.getItem('todos-v1') || '[]');
let currentFilter = 'all'; // renamed to feel more natural

// Save current list to localStorage
function saveTodos() {
  try {
    localStorage.setItem('todos-v1', JSON.stringify(todos));
  } catch (err) {
    console.error('Failed to save todos:', err);
  }
}

// Quick function to re-render everything
function renderTodos() {
  todoList.innerHTML = '';

  // Filtering logic – not the most elegant, but readable enough
  const visibleTodos = todos.filter(t => {
    if (currentFilter === 'all') return true;
    if (currentFilter === 'active') return !t.completed;
    if (currentFilter === 'completed') return t.completed;
  });

  visibleTodos.forEach(todo => {
    const row = document.createElement('div');
    row.className = 'todo';
    if (todo.completed) row.classList.add('done');
    row.setAttribute('data-id', todo.id);

    // Left side (checkbox + text)
    const left = document.createElement('div');
    left.className = 'left';

    const checkbox = document.createElement('button');
    checkbox.className = 'checkbox' + (todo.completed ? ' checked' : '');
    checkbox.innerHTML = todo.completed ? '✓' : '';
    checkbox.title = 'Merkitse tehtävä valmiiksi';
    checkbox.addEventListener('click', () => {
      todo.completed = !todo.completed;
      saveTodos();
      renderTodos();
    });

    const textWrap = document.createElement('div');
    textWrap.style.flex = '1';

    const text = document.createElement('div');
    text.className = 'text' + (todo.completed ? ' completed' : '');
    text.textContent = todo.text;
    text.tabIndex = 0;

    // double-click edit (could use contenteditable but prefer this for now)
    text.addEventListener('dblclick', () => startEdit(todo.id, textWrap));
    text.addEventListener('keydown', e => {
      if (e.key === 'Enter') startEdit(todo.id, textWrap);
    });

    textWrap.appendChild(text);
    left.appendChild(checkbox);
    left.appendChild(textWrap);

    // Right side (actions)
    const actions = document.createElement('div');
    actions.className = 'actions';

    const editBtn = document.createElement('button');
    editBtn.className = 'icon-btn';
    editBtn.innerHTML = '✎';
    editBtn.title = 'Muokkaa';
    editBtn.addEventListener('click', () => startEdit(todo.id, textWrap));

    const delBtn = document.createElement('button');
    delBtn.className = 'icon-btn';
    delBtn.innerHTML = '🗑️';
    delBtn.title = 'Poista';
    delBtn.addEventListener('click', () => {
      todos = todos.filter(t => t.id !== todo.id);
      saveTodos();
      renderTodos();
    });

    actions.appendChild(editBtn);
    actions.appendChild(delBtn);

    row.appendChild(left);
    row.appendChild(actions);
    todoList.appendChild(row);
  });

  // Update counts
  const activeCount = todos.filter(t => !t.completed).length;
  remaining.textContent = `${todos.length} tehtävää`;
  info.textContent = `${activeCount} aktiivista`;

  // highlight active filter button
  filters.forEach(btn => btn.classList.toggle('active', btn.dataset.filter === currentFilter));
}

// Edit mode for a todo
function startEdit(id, container) {
  const todo = todos.find(t => t.id === id);
  if (!todo) return;

  container.innerHTML = '';

  const input = document.createElement('input');
  input.className = 'edit-input';
  input.value = todo.text;
  container.appendChild(input);
  input.focus();

  // helper inside function (probably could move out but fine for now)
  function finishEditing(saveIt) {
    if (saveIt) {
      const newVal = input.value.trim();
      if (newVal) todo.text = newVal;
      else todos = todos.filter(t => t.id !== id);
    }
    saveTodos();
    renderTodos();
  }

  input.addEventListener('keydown', e => {
    if (e.key === 'Enter') finishEditing(true);
    if (e.key === 'Escape') finishEditing(false);
  });

  input.addEventListener('blur', () => finishEditing(true));
}

// Adds a new todo (I could debounce but no need)
function addTodo(text) {
  const val = text.trim();
  if (!val) return;

  const newTodo = {
    id: Date.now().toString(), // maybe switch to uuid later
    text: val,
    completed: false
  };

  todos.unshift(newTodo);
  saveTodos();
  renderTodos();
}

// --- Event listeners ---
addBtn.addEventListener('click', () => {
  addTodo(newTodoInput.value);
  newTodoInput.value = '';
  newTodoInput.focus();
});

newTodoInput.addEventListener('keydown', e => {
  if (e.key === 'Enter') {
    addTodo(newTodoInput.value);
    newTodoInput.value = '';
  }
});

filters.forEach(btn => {
  btn.addEventListener('click', () => {
    currentFilter = btn.dataset.filter;
    renderTodos();
  });
});

clearCompletedBtn.addEventListener('click', () => {
  todos = todos.filter(t => !t.completed);
  saveTodos();
  renderTodos();
});

// initial render
renderTodos();

